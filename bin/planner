#!/usr/bin/env node
// planner CLI - zero-dependency Node (>= 20, ESM) client for the planner Worker, used by Claude Code and by hand.
//
//   config:  ~/.config/planner/config.json  {"url": "https://planner.<sub>.workers.dev"}   (or PLANNER_URL env)
//   token:   PLANNER_TOKEN env, else the login Keychain item "planner-app-token"
//            (security find-generic-password -s planner-app-token -w). The token is never printed.
//
// Exit codes: 0 ok, 1 error (network, auth, server), 2 usage / not available yet.

import { readFile, writeFile, mkdir } from 'node:fs/promises'
import { execFile } from 'node:child_process'
import { promisify } from 'node:util'
import { homedir } from 'node:os'
import { join } from 'node:path'

const execFileP = promisify(execFile)
const CONFIG_DIR = process.env.PLANNER_CONFIG_DIR || join(homedir(), '.config', 'planner')
const CONFIG_FILE = join(CONFIG_DIR, 'config.json')
const KEYCHAIN_SERVICE = 'planner-app-token'
const TIMEOUT_MS = 15000

const USAGE = `planner - CLI for the planner Worker

Usage: planner <command> [options]

Available now (milestones 1-2, 7):
  me                      validate the token; prints role, tz, server time, today
  health                  liveness (/api/health) + automation health rows
  today [--json]          pretty-print today: routine state, sleep, streak, running timers, health
  day [date] [--json]     one day as text (GET /api/day/:date): category totals (h m), the 24 h timeline
                          as "HH:MM–HH:MM  category  label (source)" rows, and the gaps
                          date = YYYY-MM-DD | today (default) | yesterday, in the server's timezone
  tap <item> [--at ISO]   POST /api/tap as the app role (shower|run|stretch|shoulders|journal|bed|wake|winddown)
  taps [--json]           last 100 tap_log rows (newest first)
  rollup [day] [--json]   rebuild one day's day_summary row now (POST /api/rollup) and print it
                          date = YYYY-MM-DD | today | yesterday (default)
  export [--out FILE]     GET /api/export -> a JSON dump of every table (default ~/planner-backups/export-<date>.json)
  screentime phone --day YYYY-MM-DD --hours '{"7":12,"8":45,...}' [--device NAME] [--dry-run]
                          local hours -> UTC '_total' rows for that day, POST /api/screentime as the app role
                          (source 'phone'); --dry-run prints the body instead of posting it
  config [--url URL]      show or set the Worker URL in ~/.config/planner/config.json

Arriving in later milestones (exit 2 for now):
  food add --json         (M3)   food search <q>     (M3)   eat ...        (M3)   block add ...  (M3)
  session add ...         (M5)   set add ...         (M5)

Global: --json prints the raw API response. --help / -h prints this.
Token: PLANNER_TOKEN env or Keychain item "${KEYCHAIN_SERVICE}" (security add-generic-password -U -a "$USER" -s ${KEYCHAIN_SERVICE} -w).
`

const LATER = {
  'food add': 3, 'food search': 3, eat: 3, 'block add': 3,
  'session add': 5, 'set add': 5,
}

// ---------------------------------------------------------------- args

// Flags that never take a value, so `planner day --json yesterday` keeps "yesterday" as a positional.
const BOOL_FLAGS = new Set(['json', 'help', 'dry-run'])

function parseArgs(argv) {
  const positional = []
  const flags = {}
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '--') { positional.push(...argv.slice(i + 1)); break }
    if (a.startsWith('--')) {
      const eq = a.indexOf('=')
      if (eq > 0) { flags[a.slice(2, eq)] = a.slice(eq + 1); continue }
      const key = a.slice(2)
      const next = argv[i + 1]
      if (!BOOL_FLAGS.has(key) && next !== undefined && !next.startsWith('--')) { flags[key] = next; i++ } else flags[key] = true
    } else if (a === '-h') {
      flags.help = true
    } else {
      positional.push(a)
    }
  }
  return { positional, flags }
}

// ---------------------------------------------------------------- config + token

async function readConfig() {
  try {
    const raw = await readFile(CONFIG_FILE, 'utf8')
    const cfg = JSON.parse(raw)
    return cfg && typeof cfg === 'object' ? cfg : {}
  } catch (e) {
    if (e && e.code === 'ENOENT') return {}
    throw new Error(`cannot read ${CONFIG_FILE}: ${e.message}`)
  }
}

async function baseUrl() {
  const env = (process.env.PLANNER_URL || '').trim()
  const cfg = env ? { url: env } : await readConfig()
  const url = typeof cfg.url === 'string' ? cfg.url.trim().replace(/\/+$/, '') : ''
  if (!url) {
    throw new Error(`no Worker URL. Run: planner config --url https://planner.<sub>.workers.dev  (or set PLANNER_URL)`)
  }
  return url
}

async function token() {
  const env = (process.env.PLANNER_TOKEN || '').trim()
  if (env) return env
  try {
    const { stdout } = await execFileP('security', ['find-generic-password', '-s', KEYCHAIN_SERVICE, '-w'], { timeout: 30000 })
    const t = stdout.trim()
    if (t) return t
  } catch {
    // fall through
  }
  throw new Error(`no APP_TOKEN. Set PLANNER_TOKEN or store it: security add-generic-password -U -a "$USER" -s ${KEYCHAIN_SERVICE} -w`)
}

// ---------------------------------------------------------------- http

function describeFetchError(e) {
  if (e && e.name === 'TimeoutError') return `timeout after ${TIMEOUT_MS / 1000}s`
  const c = e && e.cause
  if (c) {
    if (c.code) return c.code
    if (Array.isArray(c.errors) && c.errors.length && c.errors[0].code) return c.errors[0].code
    if (c.message) return c.message
  }
  return (e && e.message) || String(e)
}

async function api(method, path, { auth = true, body } = {}) {
  const url = (await baseUrl()) + path
  const headers = { accept: 'application/json' }
  if (auth) headers.authorization = `Bearer ${await token()}`
  if (body !== undefined) headers['content-type'] = 'application/json'
  let res
  try {
    res = await fetch(url, {
      method, headers, body: body === undefined ? undefined : JSON.stringify(body), signal: AbortSignal.timeout(TIMEOUT_MS),
    })
  } catch (e) {
    throw new Error(`cannot reach ${url}: ${describeFetchError(e)}`)
  }
  const text = await res.text()
  let data = null
  try { data = text ? JSON.parse(text) : null } catch { data = { raw: text.slice(0, 300) } }
  if (res.status === 401) throw new Error(`token rejected (401) by ${url}. Check PLANNER_TOKEN / the "${KEYCHAIN_SERVICE}" Keychain item.`)
  if (res.status === 403) throw new Error(`forbidden (403): this token's role may not call ${method} ${path}`)
  if (res.status === 404) throw new Error(`${method} ${path} -> 404 (route not deployed yet, or wrong URL ${url})`)
  if (!res.ok && !(res.status === 400 && data && typeof data === 'object' && 'action' in data)) {
    const msg = data && typeof data === 'object' && (data.message || data.error) ? (data.message || data.error) : text.slice(0, 300)
    throw new Error(`${method} ${path} -> ${res.status}${msg ? `: ${msg}` : ''}`)
  }
  return { status: res.status, data }
}

// ---------------------------------------------------------------- formatting

const pad2 = (n) => String(n).padStart(2, '0')

function localHHMM(iso, tz) {
  if (!iso) return '--:--'
  try {
    return new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(iso))
  } catch { return iso }
}
function localStamp(iso, tz) {
  if (!iso) return '-'
  try {
    const p = new Intl.DateTimeFormat('en-CA', {
      timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
    }).formatToParts(new Date(iso))
    const g = (t) => p.find((x) => x.type === t)?.value ?? '00'
    return `${g('year')}-${g('month')}-${g('day')} ${g('hour')}:${g('minute')}:${g('second')}`
  } catch { return iso }
}
function minutes(a, b) { return Math.round((new Date(b).getTime() - new Date(a).getTime()) / 60000) }
function hm(min) {
  if (min == null || !Number.isFinite(min)) return '?'
  const s = min < 0 ? '-' : ''
  const m = Math.abs(min)
  return m >= 60 ? `${s}${Math.floor(m / 60)}h${pad2(m % 60)}` : `${s}${m} min`
}
function ago(iso, now) {
  if (!iso) return 'never'
  const m = minutes(iso, now)
  if (m < 1) return 'just now'
  if (m < 60) return `${m} min ago`
  if (m < 48 * 60) return `${Math.round(m / 60)} h ago`
  return `${Math.round(m / 1440)} d ago`
}
function signed(n) { return n > 0 ? `+${n}` : String(n) }
function table(rows) {
  if (!rows.length) return ''
  const w = rows[0].map((_, i) => Math.max(...rows.map((r) => String(r[i] ?? '').length)))
  return rows.map((r) => r.map((c, i) => String(c ?? '').padEnd(w[i])).join('  ').trimEnd()).join('\n')
}

// ---------------------------------------------------------------- commands

async function cmdConfig(flags) {
  if (typeof flags.url === 'string' && flags.url) {
    const url = flags.url.trim().replace(/\/+$/, '')
    if (!/^https?:\/\//.test(url)) throw new Error('--url must start with http:// or https://')
    const cfg = await readConfig()
    await mkdir(CONFIG_DIR, { recursive: true, mode: 0o700 })
    await writeFile(CONFIG_FILE, JSON.stringify({ ...cfg, url }, null, 2) + '\n', { mode: 0o600 })
    console.log(`saved ${CONFIG_FILE}`)
  }
  let url = '(not set)'
  try { url = await baseUrl() } catch { /* keep */ }
  let tok = 'missing'
  try { await token(); tok = process.env.PLANNER_TOKEN ? 'from PLANNER_TOKEN env' : `from Keychain "${KEYCHAIN_SERVICE}"` } catch { /* keep */ }
  console.log(`url:    ${url}\ntoken:  ${tok}\nconfig: ${CONFIG_FILE}`)
}

async function cmdMe(flags) {
  const { data } = await api('GET', '/api/me')
  if (flags.json) return console.log(JSON.stringify(data, null, 2))
  console.log(`role: ${data.role}\ntz: ${data.tz}\nserver_time: ${data.server_time} (${localStamp(data.server_time, data.tz)} local)\ntoday: ${data.today}`)
}

async function cmdHealth(flags) {
  const live = await api('GET', '/api/health', { auth: false })
  let auto = null
  let autoErr = null
  try { auto = (await api('GET', '/api/health/automations')).data } catch (e) { autoErr = e.message }
  if (flags.json) return console.log(JSON.stringify({ health: live.data, automations: auto, automations_error: autoErr }, null, 2))
  const h = live.data || {}
  console.log(`worker: ok=${h.ok} version=${h.version} time=${h.time} today=${h.today}`)
  if (autoErr) { console.log(`automations: ${autoErr}`); return }
  const rows = (auto && auto.rows) || []
  if (!rows.length) { console.log('automations: no rows yet (nothing has reported in)'); return }
  const now = h.time || new Date().toISOString()
  console.log(table([
    ['source', 'last ok', 'last error', 'error', 'detail'],
    ...rows.map((r) => [r.source, r.last_ok_at ? `${ago(r.last_ok_at, now)} (${r.last_ok_at})` : 'never', r.last_error_at ? ago(r.last_error_at, now) : '-', r.last_error || '-', r.detail || '-']),
  ]))
}

async function cmdTap(positional, flags) {
  const item = positional[0]
  if (!item) throw usage('tap needs an item, e.g. planner tap shower')
  const body = { item }
  if (typeof flags.at === 'string') {
    const d = new Date(flags.at)
    if (Number.isNaN(d.getTime())) throw usage(`--at must be an ISO timestamp, got ${flags.at}`)
    body.ts = d.toISOString()
  }
  const { status, data } = await api('POST', '/api/tap', { body })
  if (flags.json) { console.log(JSON.stringify(data, null, 2)); if (!data.ok) process.exitCode = 1; return }
  console.log(`${data.ok ? 'ok' : `rejected (${status})`}: ${data.action} - ${data.message}${data.local_day ? `  [${data.local_day}]` : ''}`)
  if (!data.ok) process.exitCode = 1
}

async function cmdTaps(flags) {
  const { data } = await api('GET', '/api/tap/log')
  if (flags.json) return console.log(JSON.stringify(data, null, 2))
  const taps = data.taps || []
  if (!taps.length) return console.log('no taps logged yet')
  let tz = 'UTC'
  try { tz = (await api('GET', '/api/me')).data.tz || tz } catch { /* UTC fallback */ }
  console.log(table([['id', `time (${tz})`, 'item', 'role', 'result'], ...taps.map((t) => [t.id, localStamp(t.ts, tz), t.item, t.role, t.result])]))
}

function routineGlyph(row, now) {
  if (!row || row.deleted_at) return '○'
  return row.ended_at ? '●' : '◐'
}

async function cmdToday(flags) {
  const { data: t } = await api('GET', '/api/today')
  if (flags.json) return console.log(JSON.stringify(t, null, 2))
  const tz = t.tz || t.settings?.tz || 'UTC'
  const now = t.now
  const out = []
  out.push(`Today ${t.today} (${tz}) - now ${localHHMM(now, tz)}`)

  // routine
  out.push('', 'Routine')
  const logByItem = new Map((t.routine_log || []).map((r) => [r.item_id, r]))
  const items = t.routine_items || []
  let done = 0
  const rows = items.map((it) => {
    const row = logByItem.get(it.id)
    const live = row && !row.deleted_at ? row : null
    let state = 'not started'
    if (live && live.ended_at) { done++; state = `done ${localHHMM(live.started_at, tz)} -> ${localHHMM(live.ended_at, tz)} (${hm(minutes(live.started_at, live.ended_at))})` }
    else if (live) state = `started ${localHHMM(live.started_at, tz)} (${hm(minutes(live.started_at, now))} so far, default ${it.default_min} min)`
    return [`  ${routineGlyph(live, now)}`, it.name, `[${it.id}]`, state + (live ? ` via ${live.source}` : '')]
  })
  out.push(rows.length ? table(rows) : '  (no active routine items)')
  out.push(`  ${done}/${items.length} done`)

  // sleep
  const s = t.sleep || {}
  const grace = t.settings?.late_grace_min ?? 15
  out.push('', 'Sleep')
  const fmtNight = (r) => {
    if (!r) return null
    const dur = r.wake_ts ? hm(minutes(r.bed_ts, r.wake_ts)) : null
    const late = `${signed(r.late_min)} min vs ${r.target_bed}${r.late_min > grace ? ' LATE' : ''}`
    return `in bed ${localHHMM(r.bed_ts, tz)} (${late})` + (r.wake_ts ? ` - up ${localHHMM(r.wake_ts, tz)} (${r.wake_source}) - ${dur}` : ' - no wake yet')
  }
  out.push(`  last night (${s.last_night?.night_of ?? '-'}): ${fmtNight(s.last_night) ?? 'no row'}`)
  out.push(`  tonight (${s.tonight?.night_of ?? '-'}):    ${fmtNight(s.tonight) ?? `not in bed yet (target ${t.settings?.bed_target ?? '?'}, wind-down ${t.settings?.winddown_min ?? '?'} min before)`}`)
  if (s.open) out.push(`  OPEN: night ${s.open.night_of} has no wake time yet - tap a routine sticker or set it in the app ("When did you wake?")`)
  out.push(`  streak: ${s.streak ?? 0} night${s.streak === 1 ? '' : 's'} on target (grace ${grace} min)`)

  // running
  const r = t.running || {}
  out.push('', 'Running')
  if (!r.workout && !r.session) out.push('  nothing running')
  if (r.workout) out.push(`  workout ${r.workout.name || '(unnamed)'} since ${localHHMM(r.workout.started_at, tz)} (${hm(minutes(r.workout.started_at, now))})`)
  if (r.session) out.push(`  session ${r.session.project_name} since ${localHHMM(r.session.started_at, tz)} (${hm(minutes(r.session.started_at, now))})`)

  // check-in
  const c = t.checkin
  out.push('', 'Check-in')
  out.push(`  AM: ${c?.morning_at ? `${localHHMM(c.morning_at, tz)} ${c.morning_note ? JSON.stringify(c.morning_note) : ''}` : '-'}`)
  out.push(`  PM: ${c?.evening_at ? `${localHHMM(c.evening_at, tz)} ${c.evening_note ? JSON.stringify(c.evening_note) : ''}` : '-'}`)

  // health
  const h = t.health || {}
  out.push('', 'Health')
  const hrows = h.rows || []
  if (hrows.length) {
    out.push(table(hrows.map((x) => [`  ${x.source}`, x.last_ok_at ? `ok ${ago(x.last_ok_at, now)}` : 'never ok', x.last_error_at ? `error ${ago(x.last_error_at, now)}: ${x.last_error || ''}` : '', x.detail || ''])))
  } else out.push('  no automation rows yet')
  out.push(`  taps today: ${h.taps_today ?? 0}`)
  out.push(`  mac last hour: ${h.mac_last_hour ? `${localStamp(h.mac_last_hour, tz)} (${ago(h.mac_last_hour, now)})` : 'none'}`)
  out.push(`  phone last hour: ${h.phone_last_hour ? `${localStamp(h.phone_last_hour, tz)} (${ago(h.phone_last_hour, now)})` : 'none'}`)
  out.push(`  apps to categorise: ${h.apps_to_triage ?? 0}`)
  console.log(out.join('\n'))
}

// ---- day: GET /api/day/:date (the buildDay result from src/shared/day.ts) printed as text.
// This is how Claude Code answers "how did yesterday go": totals per category, one row per block, the gaps.

function shiftDay(day, delta) {
  const [y, m, d] = day.split('-').map(Number)
  const t = new Date(Date.UTC(y, m - 1, d + delta))
  return `${t.getUTCFullYear()}-${pad2(t.getUTCMonth() + 1)}-${pad2(t.getUTCDate())}`
}

/** "today" and "yesterday" mean the server's local day (settings.tz), not this machine's clock. */
async function resolveDay(arg) {
  const a = String(arg ?? 'today').trim().toLowerCase()
  if (/^\d{4}-\d{2}-\d{2}$/.test(a)) return a
  if (a !== 'today' && a !== 'yesterday') throw usage(`day wants YYYY-MM-DD, today or yesterday, got "${arg}"`)
  const me = (await api('GET', '/api/me')).data
  const today = me && typeof me.today === 'string' ? me.today : null
  if (!today) throw new Error('/api/me did not say what today is')
  return a === 'today' ? today : shiftDay(today, -1)
}

/** seconds -> "7h 32m" (the h m column of the totals table). */
function hms(sec) {
  const m = Math.max(0, Math.round((Number(sec) || 0) / 60))
  return `${Math.floor(m / 60)}h ${pad2(m % 60)}m`
}

async function cmdDay(positional, flags) {
  const day = await resolveDay(positional[0])
  const { data: d } = await api('GET', `/api/day/${day}`)
  if (flags.json) return console.log(JSON.stringify(d, null, 2))
  if (!d || typeof d !== 'object' || !Array.isArray(d.blocks)) throw new Error(`GET /api/day/${day}: unexpected response (no blocks array)`)
  const tz = d.tz || 'UTC'
  const t = d.totals || {}
  const gaps = Array.isArray(d.gaps) ? d.gaps : []
  const clock = (iso) => (iso && iso === d.end ? '24:00' : localHHMM(iso, tz))
  const span = (a, b) => `${clock(a)}–${clock(b)}`
  // Seconds scored so far: the whole day for a past day, midnight -> now for today. Minutes after now do not exist yet.
  const scored = d.now_min != null && Number.isFinite(Number(d.now_min)) ? Number(d.now_min) * 60 : Number(t.tracked_s) || 0
  const unknown = Number(t.unknown_s) || 0
  const tracked = Math.max(0, scored - unknown)
  const pct = (s) => (scored > 0 ? `${Math.round((100 * (Number(s) || 0)) / scored)}%` : '-')
  const out = []

  let head = `Day ${d.day} (${tz})`
  try { head += ` · ${new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'short', day: 'numeric', month: 'short' }).format(new Date(d.start))}` } catch { /* keep */ }
  if (d.is_today) head += ` · today, up to ${localHHMM(new Date(new Date(d.start).getTime() + scored * 1000).toISOString(), tz)}`
  out.push(head)
  out.push(`  ${d.minutes} min in the day · ${hms(scored)} scored · ${hms(tracked)} tracked (${pct(tracked)}) · ${hms(unknown)} unknown (${pct(unknown)})`)

  // totals: one row per painted category; manual/study/mac get their breakdown indented underneath
  out.push('', 'Totals')
  const rows = [['  category', 'h m', 'share']]
  const breakdownOf = (name) => (name === 'manual' ? d.manual_by_category : name === 'study' ? d.study_by_project : name === 'mac' ? d.mac_by_category : null) || {}
  let rawNote = false
  for (const [name, key] of [['sleep', 'sleep_s'], ['workout', 'workout_s'], ['study', 'study_s'], ['routine', 'routine_s'], ['mac', 'mac_s'], ['phone', 'phone_s'], ['manual', 'manual_s'], ['unknown', 'unknown_s']]) {
    const s = Number(t[key]) || 0
    if (s <= 0 && name !== 'unknown') continue
    rows.push([`  ${name}`, hms(s), pct(s)])
    for (const [k, v] of Object.entries(breakdownOf(name)).sort((a, b) => Number(b[1]) - Number(a[1]))) {
      if (name !== 'manual') rawNote = true
      rows.push([`    ${k}`, hms(v), name === 'manual' ? pct(v) : ''])
    }
  }
  out.push(table(rows))
  if (rawNote) out.push('  (study / mac sub-rows are raw seconds from the source tables, so they can exceed the painted minutes)')

  // timeline
  out.push('', `Timeline (${d.blocks.length} block${d.blocks.length === 1 ? '' : 's'})`)
  if (!d.blocks.length) out.push('  nothing yet')
  else out.push(table(d.blocks.map((b) => [`  ${span(b.start, b.end)}`, b.category, `${b.label} (${b.source})`, hms(b.minutes * 60)])))

  // gaps: unknown runs of 5 min or more (shorter ones are absorbed into the previous block for display)
  const gapMin = gaps.reduce((a, g) => a + (Number(g.minutes) || 0), 0)
  out.push('', `Gaps (${gaps.length}${gaps.length ? `, ${hms(gapMin * 60)} in runs of 5 min or more (plus any unknown run at the start of the day)` : ''})`)
  if (!gaps.length) out.push('  none')
  else {
    out.push(table(gaps.map((g) => [`  ${span(g.start, g.end)}`, hms(g.minutes * 60)])))
    out.push('  fill one by tapping it in the Day tab (planner block add arrives with milestone 3)')
  }

  if (Array.isArray(d.markers) && d.markers.length) {
    out.push('', 'Meals')
    out.push(table(d.markers.map((m) => [`  ${localHHMM(m.ts, tz)}`, m.label, `${m.kcal} kcal`, m.slot])))
  }
  if (d.sleep_inferred) out.push('', '  note: a night has no wake time yet, so its sleep is drawn as an 8 h guess (Sleep?). Set the wake time in the app.')
  console.log(out.join('\n'))
}

// ---- rollup: POST /api/rollup {day} -> the day_summary row, printed as a small table.

function printSummary(s, indent = '  ') {
  const rows = [[`${indent}category`, 'h m']]
  for (const [name, key] of [['sleep', 'sleep_s'], ['workout', 'workout_s'], ['study', 'study_s'], ['routine', 'routine_s'], ['mac', 'mac_s'], ['phone', 'phone_s'], ['manual', 'manual_s'], ['unknown', 'unknown_s']]) {
    const v = Number(s[key]) || 0
    if (v <= 0 && name !== 'unknown') continue
    rows.push([`${indent}${name}`, hms(v)])
  }
  rows.push([`${indent}tracked`, hms(s.tracked_s)])
  const out = [table(rows)]
  const maps = [['manual', s.manual_by_category], ['study (raw)', s.study_by_project], ['mac (raw)', s.mac_by_category]]
  for (const [label, map] of maps) {
    const entries = Object.entries(map || {}).sort((a, b) => Number(b[1]) - Number(a[1]))
    if (entries.length) out.push(`${indent}${label}: ${entries.map(([k, v]) => `${k} ${hms(v)}`).join(', ')}`)
  }
  const food = s.kcal == null ? 'no food logged' : `${Math.round(s.kcal)} kcal · P ${Math.round(s.protein_g || 0)} C ${Math.round(s.carb_g || 0)} F ${Math.round(s.fat_g || 0)}`
  out.push(`${indent}food: ${food}`)
  out.push(`${indent}lift: ${s.sets_count} sets, volume ${s.volume}  ·  sessions: ${s.sessions_count}  ·  routine: ${s.routine_done}/${s.routine_total}`)
  out.push(`${indent}bed: ${s.bed_late_min == null ? 'no bed tap that night' : `${signed(s.bed_late_min)} min vs target`}  ·  final: ${s.final ? 'yes' : 'no'}  ·  computed ${s.computed_at || '-'}`)
  return out.join('\n')
}

async function cmdRollup(positional, flags) {
  const day = await resolveDay(positional[0] ?? 'yesterday')
  const { data } = await api('POST', '/api/rollup', { body: { day } })
  if (flags.json) return console.log(JSON.stringify(data, null, 2))
  if (!data || !data.summary) throw new Error('POST /api/rollup: unexpected response (no summary)')
  console.log(`Rebuilt ${data.day}`)
  console.log(printSummary(data.summary))
}

// ---- export: GET /api/export -> one JSON file (never printed to the terminal; it can be large).

function localDateStamp() {
  const p = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date())
  const g = (t) => p.find((x) => x.type === t)?.value ?? '00'
  return `${g('year')}-${g('month')}-${g('day')}`
}

async function cmdExport(flags) {
  const out = typeof flags.out === 'string' && flags.out ? flags.out : join(homedir(), 'planner-backups', `export-${localDateStamp()}.json`)
  const { data } = await api('GET', '/api/export')
  if (!data || typeof data !== 'object' || !data.tables) throw new Error('GET /api/export: unexpected response (no tables)')
  await mkdir(join(out, '..'), { recursive: true, mode: 0o700 })
  const text = JSON.stringify(data, null, 1) + '\n'
  await writeFile(out, text, { mode: 0o600 })
  if (flags.json) return console.log(JSON.stringify({ file: out, bytes: Buffer.byteLength(text), exported_at: data.exported_at, counts: data.counts, truncated: data.truncated, row_cap: data.row_cap }, null, 2))
  console.log(`wrote ${out} (${(Buffer.byteLength(text) / 1024).toFixed(0)} KB, exported ${data.exported_at})`)
  const counts = data.counts || {}
  console.log(table(Object.keys(counts).map((t) => [`  ${t}`, String(counts[t])])))
  if (Array.isArray(data.truncated) && data.truncated.length) console.log(`  note: capped at ${data.row_cap} rows per table; truncated: ${data.truncated.join(', ')}`)
}

// ---- screentime phone: local hours -> UTC '_total' rows -> POST /api/screentime (source 'phone').

/** Offset (ms) such that instant + offset == the wall clock in tz (same algorithm as src/shared/tz.ts). */
function tzOffsetMs(date, tz) {
  const p = new Intl.DateTimeFormat('en-US', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' }).formatToParts(date)
  const g = (t) => Number(p.find((x) => x.type === t)?.value ?? '0')
  const h = g('hour') === 24 ? 0 : g('hour')
  return Date.UTC(g('year'), g('month') - 1, g('day'), h, g('minute'), g('second')) - Math.floor(date.getTime() / 1000) * 1000
}
/** UTC instant of a wall-clock hour in tz, correct across DST changes. */
function zonedToUTC(day, hour, tz) {
  const [y, m, d] = day.split('-').map(Number)
  const guess = Date.UTC(y, m - 1, d, hour, 0, 0)
  const off = tzOffsetMs(new Date(guess), tz)
  let inst = guess - off
  const off2 = tzOffsetMs(new Date(inst), tz)
  if (off2 !== off) inst = guess - off2
  return new Date(inst)
}

function parseHours(raw) {
  let obj
  try { obj = JSON.parse(raw) } catch (e) { throw usage(`--hours must be JSON like '{"7":12,"8":45}': ${e.message}`) }
  if (!obj || typeof obj !== 'object' || Array.isArray(obj)) throw usage('--hours must be a JSON object of local hour -> minutes')
  const hours = []
  for (const [k, v] of Object.entries(obj)) {
    const h = Number(k)
    if (!Number.isInteger(h) || h < 0 || h > 23) throw usage(`--hours: "${k}" is not a local hour 0-23`)
    const min = Number(v)
    if (!Number.isFinite(min) || min < 0 || min > 60) throw usage(`--hours: hour ${k} has ${JSON.stringify(v)} minutes (want 0-60)`)
    hours.push([h, min])
  }
  if (!hours.length) throw usage('--hours has no hours in it; nothing to post (an empty push never wipes data)')
  return hours.sort((a, b) => a[0] - b[0])
}

async function cmdScreentimePhone(flags) {
  const day = typeof flags.day === 'string' ? flags.day.trim() : ''
  if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) throw usage('screentime phone needs --day YYYY-MM-DD')
  if (typeof flags.hours !== 'string') throw usage('screentime phone needs --hours \'{"7":12,"8":45}\' (local hour -> minutes)')
  const hours = parseHours(flags.hours)
  const device = typeof flags.device === 'string' && flags.device ? flags.device : 'iPhone'
  // The server's timezone decides which UTC hour a local hour is; --tz only exists for --dry-run without a server.
  let tz = typeof flags.tz === 'string' && flags.tz ? flags.tz : null
  if (!tz) {
    const me = (await api('GET', '/api/me')).data
    tz = me && typeof me.tz === 'string' ? me.tz : null
    if (!tz) throw new Error('/api/me did not say what the timezone is')
  }
  const rows = hours.map(([h, min]) => ({ hour_start: zonedToUTC(day, h, tz).toISOString(), app_id: '_total', seconds: Math.min(3600, Math.round(min * 60)) }))
  const body = {
    source: 'phone', device,
    window: { from: zonedToUTC(day, 0, tz).toISOString(), to: zonedToUTC(shiftDay(day, 1), 0, tz).toISOString() },
    hours: rows,
  }
  const total = hours.reduce((a, [, m]) => a + m, 0)
  if (flags['dry-run']) {
    console.log(JSON.stringify(body, null, 2))
    console.error(`dry run: ${rows.length} hour rows, ${hm(Math.round(total))} total on ${day} (${tz}); nothing posted`)
    return
  }
  const { data } = await api('POST', '/api/screentime', { body })
  if (flags.json) return console.log(JSON.stringify(data, null, 2))
  const n = (k, d) => (data && data[k] != null ? data[k] : d)
  const days = data && Array.isArray(data.days) && data.days.length ? ` · days marked for rollup: ${data.days.join(', ')}` : ''
  console.log(`ok: ${day} (${tz}) · ${n('hours', rows.length)} hours (${hm(Math.round(total))} on the phone), ${n('intervals', 0)} intervals, ${n('apps_new', 0)} new apps${days}`)
}

// ---------------------------------------------------------------- dispatch

function usage(msg) { const e = new Error(msg); e.usage = true; return e }

async function main() {
  const { positional, flags } = parseArgs(process.argv.slice(2))
  const cmd = positional[0]
  if (!cmd || flags.help || cmd === 'help') { process.stdout.write(USAGE); return }
  const two = positional.slice(0, 2).join(' ')
  const later = LATER[two] ?? LATER[cmd]
  if (later !== undefined) {
    console.error(`planner ${LATER[two] !== undefined ? two : cmd}: not available until milestone ${later}`)
    process.exitCode = 2
    return
  }
  switch (cmd) {
    case 'config': return cmdConfig(flags)
    case 'me': return cmdMe(flags)
    case 'health': return cmdHealth(flags)
    case 'today': return cmdToday(flags)
    case 'day': return cmdDay(positional.slice(1), flags)
    case 'tap': return cmdTap(positional.slice(1), flags)
    case 'taps': return cmdTaps(flags)
    case 'rollup': return cmdRollup(positional.slice(1), flags)
    case 'export': return cmdExport(flags)
    case 'screentime':
      if (positional[1] === 'phone') return cmdScreentimePhone(flags)
      throw usage(`screentime wants "phone", got "${positional[1] ?? ''}"`)
    default:
      throw usage(`unknown command: ${cmd}`)
  }
}

main().catch((e) => {
  if (e && e.usage) {
    console.error(`planner: ${e.message}\n`)
    process.stderr.write(USAGE)
    process.exitCode = 2
    return
  }
  console.error(`planner: ${e && e.message ? e.message : e}`)
  process.exitCode = 1
})
